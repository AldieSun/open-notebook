-- Migration 12: Fix vector_search_v2 to exclude source_insight
-- This migration forces an update to the function by removing and recreating it

-- Remove the old function first
REMOVE FUNCTION IF EXISTS fn::vector_search_v2;

-- Recreate with correct logic (no source_insight)
DEFINE FUNCTION fn::vector_search_v2(
    $query: array<float>,
    $match_count: int,
    $sources: bool,
    $show_notes: bool,
    $min_similarity: float
) {
    -- source_embedding: return chunk-level results from original documents ONLY
    -- Explicitly does NOT include source_insight (LLM-generated summaries)
    let $source_embedding_search =
        IF $sources {(
            SELECT
                id,
                source.id as source_id,
                source.title as source_title,
                content,
                order as chunk_order,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM source_embedding
            WHERE embedding != NONE
              AND array::len(embedding) = array::len($query)
              AND vector::similarity::cosine(embedding, $query) >= $min_similarity
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    -- note: user-created notes only (NOT source_insight)
    let $note_content_search =
        IF $show_notes {(
            SELECT
                id,
                id as source_id,
                title as source_title,
                content,
                0 as chunk_order,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM note
            WHERE embedding != NONE
              AND array::len(embedding) = array::len($query)
              AND vector::similarity::cosine(embedding, $query) >= $min_similarity
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    -- Combine results - NO source_insight included
    let $all_results = array::union($source_embedding_search, $note_content_search);

    -- Return individual chunks (no grouping)
    RETURN (
        SELECT id, source_id, source_title, content, chunk_order, similarity
        FROM $all_results
        WHERE id IS NOT NONE
        ORDER BY similarity DESC
        LIMIT $match_count
    );
};
