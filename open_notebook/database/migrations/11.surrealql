-- Migration 11: Add chunk-level vector search function for precise citations
-- This function returns individual chunks without aggregating to source level

DEFINE FUNCTION IF NOT EXISTS fn::vector_search_v2(
    $query: array<float>,
    $match_count: int,
    $sources: bool,
    $show_notes: bool,
    $min_similarity: float
) {
    -- source_embedding: return chunk-level results (no aggregation to source)
    let $source_embedding_search =
        IF $sources {(
            SELECT
                id,
                source.id as source_id,
                source.title as source_title,
                content,
                order as chunk_order,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM source_embedding
            WHERE embedding != NONE
              AND array::len(embedding) = array::len($query)
              AND vector::similarity::cosine(embedding, $query) >= $min_similarity
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    -- source_insight: keep insight-level results
    let $source_insight_search =
        IF $sources {(
            SELECT
                id,
                source.id as source_id,
                insight_type + ' - ' + source.title as source_title,
                content,
                0 as chunk_order,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM source_insight
            WHERE embedding != NONE
              AND array::len(embedding) = array::len($query)
              AND vector::similarity::cosine(embedding, $query) >= $min_similarity
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    -- note: keep note-level results
    let $note_content_search =
        IF $show_notes {(
            SELECT
                id,
                id as source_id,
                title as source_title,
                content,
                0 as chunk_order,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM note
            WHERE embedding != NONE
              AND array::len(embedding) = array::len($query)
              AND vector::similarity::cosine(embedding, $query) >= $min_similarity
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    let $all_results = array::union(
        array::union($source_embedding_search, $source_insight_search),
        $note_content_search
    );

    -- No GROUP BY, keep each chunk as independent result
    RETURN (
        SELECT id, source_id, source_title, content, chunk_order, similarity
        FROM $all_results
        WHERE id IS NOT NONE
        ORDER BY similarity DESC
        LIMIT $match_count
    );
};
